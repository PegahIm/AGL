  RowBox[{
   RowBox[{
    RowBox[{"strings1", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<bXXVTe\>\"", ",", "\"\<bXXVXJJe\>\"", ",", "\"\<bVXJJe\>\"",
        ",", "\"\<bXVJTVJe\>\"", ",", "\"\<bXXVXJe\>\"", ",", "\"\<bXVXe\>\"",
        ",", "\"\<bXXXVTe\>\"", ",", "\"\<bVJe\>\"", ",", "\"\<bXVXJJJe\>\"", 
       ",", "\"\<bVJTVTVe\>\"", ",", "\"\<bVJTVXe\>\"", 
       ",", "\"\<bXXXVTVe\>\"", ",", "\"\<bXXVJe\>\"", ",", "\"\<bXVXJJe\>\"",
        ",", "\"\<bVTe\>\"", ",", "\"\<bVJTVXJe\>\"", ",", "\"\<bXXXVXe\>\"", 
       ",", "\"\<bVJTXVJe\>\"", ",", "\"\<bXVXJe\>\"", ",", "\"\<bXXXXVXe\>\"",
        ",", "\"\<bXVTe\>\"", ",", "\"\<bVJTVJe\>\"", 
       ",", "\"\<bVXJJJJe\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"strings2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"StringDrop", "[", 
