               RowBox[{
                RowBox[{"Last", "[", "bigram", "]"}], "/", 
                RowBox[{"Total", "[", 
                 RowBox[{"Last", "/@", "bigrams"}], "]"}]}]}], "}"}]}], "]"}],
            ",", "bigrams"}], "]"}]}], "]"}], ",", "groupedBigrams"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
