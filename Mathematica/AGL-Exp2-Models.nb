     RowBox[{"Rule", "@@@", "bigram1Counts"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trigrams", "=", 
     RowBox[{"trigramsFunc", "[", "strings1", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trigramCounts", "=", 
     RowBox[{"trigramCountsFunc", "[", "trigrams", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"formattedCountsTrigrams", "=", 
     RowBox[{"Rule", "@@@", "trigramCounts"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"chunksFunc", "[", "strings_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bigrams1", ",", "trigrams"}], "}"}], ",", 
       RowBox[{
        RowBox[{"bigrams1", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"StringJoin", "@@@", 
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Characters", "[", "#", "]"}], ",", "2", ",", "1"}], 
             "]"}]}], "&"}], "/@", "strings"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"trigrams", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"StringJoin", "@@@", 
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Characters", "[", "#", "]"}], ",", "3", ",", "1"}], 
             "]"}]}], "&"}], "/@", "strings"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"MapThread", "[", 
