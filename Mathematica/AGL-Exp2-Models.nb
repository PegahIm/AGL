              RowBox[{
               RowBox[{"res", "[", "\"\<Quantum\>\"", "]"}], 
               "[", "\"\<Predicted\>\"", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "4"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"res", "[", "\"\<TestItems\>\"", "]"}], "]"}]}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Test item\>\"", ",", "\"\<Observed\>\"", 
         ",", "\"\<Bayesian (predicted)\>\"", 
         ",", "\"\<Quantum (predicted)\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Left"}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"LightGray", ",", "None", ",", "None"}], "}"}]}], "}"}]}]}], 
