Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Training", " ", "items"}], ",", 
    RowBox[{"anchored", " ", "at", " ", "both", " ", "beginning", " ", 
     RowBox[{"(", "\"\<b\>\"", ")"}], " ", "and", " ", "end", " ", 
