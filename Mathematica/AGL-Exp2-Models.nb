Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"calculateCoefficientsQuantum", "[", 
     RowBox[{"freq_", ",", "th1_", ",", "th2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alpha", ",", "beta", ",", "alphaPrime", ",", "betaPrime"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"alpha", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "th1"}], "]"}], " ", 
         RowBox[{"Sqrt", "[", "freq", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"beta", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "th2"}], "]"}]}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "freq"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"alphaPrime", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "th2"}], "]"}], " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "freq"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"betaPrime", "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", "th1"}], "]"}], " ", 
         RowBox[{"Sqrt", "[", "freq", "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"alpha", ",", "alphaPrime"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"beta", ",", "betaPrime"}], "}"}]}], "}"}]}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bigramCalculationsQuantum", "[", 
     RowBox[{"th1_", ",", "th2_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "assoc", "}"}], ",", 
      RowBox[{
       RowBox[{"assoc", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "bg", "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "bg", "]"}], "==", "2"}], ",", 
               RowBox[{
                RowBox[{"bg", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "->", 
                RowBox[{"calculateCoefficientsQuantum", "[", 
                 RowBox[{
                  RowBox[{"N", "[", 
                   RowBox[{"bg", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "th1", ",", 
                  "th2"}], "]"}]}], ",", 
               RowBox[{"bg", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}]}], 
              "]"}]}], "]"}], ",", "flatBigramsList"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{"assoc", ",", "bg"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"assoc", "[", "bg", "]"}], "=", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"bg", ",", "allBigrams"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "assoc"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementOperatorQuantum", "[", "x_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", "x"}], "]"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"Sqrt", "[", "x", "]"}]}], "}"}]}], "}"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"initialStateVectorQuantum", "[", 
     RowBox[{"firstBigram_", ",", "bigramCalcs_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bigramCalcs", "[", "firstBigram", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"bigramCalcs", "[", "firstBigram", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}], "}"}]}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"calculateQuantumProbability", "[", 
    RowBox[{"string_", ",", "bigramCalcs_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "bigramsInStr", ",", "firstBigram", ",", "stateVector", ",", 
       "conjugateStateVector", ",", "M", ",", "U", ",", "result", ",", 
       "probability", ",", 
       RowBox[{"conjRule", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", "theta1", "]"}], "->", "theta1"}], ",", 
          RowBox[{
           RowBox[{"Conjugate", "[", "theta2", "]"}], "->", "theta2"}]}], 
         "}"}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"bigramsInStr", "=", 
       RowBox[{"StringJoin", "/@", 
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"Characters", "[", "string", "]"}], ",", "2", ",", "1"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"firstBigram", "=", 
       RowBox[{"First", "[", "bigramsInStr", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"M", "=", 
       RowBox[{"measurementOperatorQuantum", "[", "x", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"conjugateStateVector", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"initialStateVectorQuantum", "[", 
          RowBox[{"firstBigram", ",", "bigramCalcs"}], "]"}], "]"}], "/.", 
        " ", "conjRule"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"U", "=", 
          RowBox[{
           RowBox[{"bigramCalcs", "[", "bg", "]"}], "/.", " ", "conjRule"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"conjugateStateVector", "=", 
          RowBox[{"Simplify", "[", 
           RowBox[{"conjugateStateVector", ".", 
            RowBox[{"ConjugateTranspose", "[", "U", "]"}]}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"bg", ",", 
          RowBox[{"Rest", "[", "bigramsInStr", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"result", "=", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"conjugateStateVector", ".", "M"}], "]"}], "/.", " ", 
        "conjRule"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stateVector", "=", 
       RowBox[{"initialStateVectorQuantum", "[", 
        RowBox[{"firstBigram", ",", "bigramCalcs"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"U", "=", 
          RowBox[{
           RowBox[{"bigramCalcs", "[", "bg", "]"}], "/.", " ", "conjRule"}]}],
          ";", "\[IndentingNewLine]", 
         RowBox[{"stateVector", "=", 
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{"U", ".", "stateVector"}], "]"}], "/.", " ", 
           "conjRule"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"bg", ",", 
          RowBox[{"Rest", "[", "bigramsInStr", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"probability", "=", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"result", ".", "M", ".", "stateVector"}], "]"}], "/.", " ", 
        "conjRule"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"probability", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9967488561674557`*^9, 3.9967488561674557`*^9}, 
   3.996756161634947*^9, 3.9967574755249996`*^9, 3.996767665190712*^9},
