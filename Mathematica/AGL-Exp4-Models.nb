Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FitDataset", "[", "sheetName_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "data", ",", "testItems", ",", "testItemsQuantum", ",", "endorsements", 
       ",", "n", ",", "y", ",", "nItems", ",", "logLClassicalDelta", ",", 
       "optimalDeltaClassical", ",", "xOptC", ",", "deltaOpt", ",", "logLC", ",",
        "bigramCalcsOpt", ",", "predictedC", ",", "G2C", ",", "BICC", ",", 
       "modelQSym", ",", "logLQuantum", ",", "quantumStarts", ",", 
       "quantumCandidates", ",", "optimalQuantum", ",", "xOptQ", ",", 
       "theta1OptQ", ",", "logLQ", ",", "predictedQ", ",", "G2Q", ",", 
       "BICQ"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"dataFile", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Sheets\>\"", ",", "sheetName"}], "}"}]}], "]"}]}], ";",
       "\n", 
      RowBox[{"testItems", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "                     ", "\n", 
      RowBox[{"testItemsAnchored", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\"\<b\>\"", "<>", "#", "<>", "\"\<e\>\""}], ")"}], "&"}], "/@",
         "testItems"}]}], ";", " ", "\n", 
      RowBox[{"endorsements", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"n", "=", "26"}], ";", "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{"n", "*", "endorsements"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nItems", "=", 
       RowBox[{"Length", "[", "testItems", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"=", "Bayesian"}], ",", 
        RowBox[{"2", " ", 
         RowBox[{"parameters", ":", 
          RowBox[{"x", " ", 
           RowBox[{"(", "epsilon", ")"}]}]}]}], ",", 
        RowBox[{"delta", "-"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"logLClassicalDelta", "[", 
        RowBox[{
         RowBox[{"xx_", "?", "NumericQ"}], ",", 
         RowBox[{"dd_", "?", "NumericQ"}]}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"bc", ",", "modelP"}], "}"}], ",", 
         RowBox[{
          RowBox[{"bc", "=", 
           RowBox[{"bigramCalculationsDelta", "[", "dd", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"modelP", "=", 
              RowBox[{"calculateClassicalProbabilityDelta", "[", 
               RowBox[{
                RowBox[{"testItemsAnchored", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "bc", ",", "xx"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"TrueQ", "[", 
                 RowBox[{"0", "<", "modelP", "<", "1"}], "]"}]}], ",", 
               RowBox[{"Return", "[", 
                RowBox[{"-", "Infinity"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"Binomial", "[", 
                RowBox[{"n", ",", 
                 RowBox[{"y", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "+", 
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", 
               RowBox[{"Log", "[", "modelP", "]"}]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n", "-", 
                 RowBox[{"y", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ")"}], " ", 
               RowBox[{"Log", "[", 
                RowBox[{"1", "-", "modelP"}], "]"}]}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "nItems"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"optimalDeltaClassical", "=", 
       RowBox[{"NMaximize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"logLClassicalDelta", "[", 
            RowBox[{"x", ",", "delta"}], "]"}], ",", 
           RowBox[{"0", "<=", "x", "<", "0.5"}], ",", 
           RowBox[{
            RowBox[{"-", "0.5"}], "<=", "delta", "<=", "0.5"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "delta"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xOptC", ",", "deltaOpt"}], "}"}], "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "delta"}], "}"}], "/.", " ", 
        RowBox[{"optimalDeltaClassical", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"logLC", "=", 
       RowBox[{"optimalDeltaClassical", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"bigramCalcsOpt", "=", 
       RowBox[{"bigramCalculationsDelta", "[", "deltaOpt", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"predictedC", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"calculateClassicalProbabilityDelta", "[", 
          RowBox[{
           RowBox[{"testItemsAnchored", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "bigramCalcsOpt", ",", 
           "xOptC"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nItems"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"G2C", "=", 
       RowBox[{"2", "*", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "*", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"y", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"n", "*", 
                RowBox[{"predictedC", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", 
              RowBox[{"y", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"n", "*", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"predictedC", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ")"}]}], 
             "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nItems"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BICC", "=", 
       RowBox[{"G2C", "+", 
        RowBox[{"2", "*", 
         RowBox[{"Log", "[", "nItems", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"multistartC", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x0", ",", "d0"}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x0", ",", "d0"}], "}"}], "=", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"RandomReal", "[", 
                RowBox[{"{", 
                 RowBox[{"0.01", ",", "0.49"}], "}"}], "]"}], ",", 
               RowBox[{"RandomReal", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"-", "0.45"}], ",", "0.45"}], "}"}], "]"}]}], 
              "}"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Quiet", "[", 
             RowBox[{"FindMaximum", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"logLClassicalDelta", "[", 
                  RowBox[{"x", ",", "delta"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"0", "<=", "x", "<=", ".499999"}], "&&", 
                  RowBox[{
                   RowBox[{"-", ".499999"}], "<=", "delta", "<=", 
                   ".499999"}]}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", ",", "x0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"delta", ",", "d0"}], "}"}]}], "}"}]}], "]"}], 
             "]"}]}]}], "]"}], ",", 
         RowBox[{"{", "20", "}"}]}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"validC", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"multistartC", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"_", "?", "NumericQ"}], ",", 
               RowBox[{"{", 
                RowBox[{"_Rule", ",", "_Rule"}], "}"}]}], "}"}]}], "]"}], "&&", 
           RowBox[{"TrueQ", "[", 
            RowBox[{
             RowBox[{"-", "Infinity"}], "<", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", "Infinity"}], "]"}]}], 
          "&"}]}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"robustC", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"validC", "===", 
          RowBox[{"{", "}"}]}], ",", "$Failed", ",", 
         RowBox[{"logLC", "-", 
          RowBox[{"Max", "[", 
           RowBox[{"validC", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Quantum", ",", 
        RowBox[{"2", " ", 
         RowBox[{"parameters", ":", "x"}]}], ",", 
        RowBox[{"theta1", " ", 
         RowBox[{"(", 
          RowBox[{"theta2", " ", "cancels", " ", "out"}], ")"}]}]}], "*)"}], 
      RowBox[{"modelQSym", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"calculateQuantumProbability", "[", 
          RowBox[{
           RowBox[{"testItemsAnchored", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"bigramCalculationsQuantum", "[", 
            RowBox[{"theta1", ",", "theta2"}], "]"}], ",", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nItems"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"logLQuantum", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"Binomial", "[", 
            RowBox[{"n", ",", 
             RowBox[{"y", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", 
           RowBox[{"Re", "[", 
            RowBox[{"Log", "[", 
             RowBox[{"modelQSym", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", 
             RowBox[{"y", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
           RowBox[{"Re", "[", 
            RowBox[{"Log", "[", 
             RowBox[{"1", "-", 
              RowBox[{"modelQSym", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nItems"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"quantumStarts", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"th1", ",", "x0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"th1", ",", "0.", ",", 
             RowBox[{
              RowBox[{"2", " ", "Pi"}], "-", "0.01"}], ",", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "60"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x0", ",", 
             RowBox[{"{", 
              RowBox[{
              "0.05", ",", "0.15", ",", "0.25", ",", "0.35", ",", "0.45"}], 
              "}"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"quantumCandidates", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Quiet", "@", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"FindMaximum", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"logLQuantum", ",", 
                RowBox[{"0", "<=", "theta1", "<", 
                 RowBox[{"2", " ", "Pi"}]}], ",", 
                RowBox[{"0", "<=", "x", "<", "0.5"}], ",", 
                RowBox[{
                 RowBox[{"Im", "[", "logLQuantum", "]"}], "==", "0"}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"theta1", ",", 
                  RowBox[{"s", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"x", ",", 
                  RowBox[{"s", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "}"}]}], "]"}], 
            ",", "$Failed"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "quantumStarts"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"quantumCandidates", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"quantumCandidates", ",", 
         RowBox[{
          RowBox[{"#", "=!=", "$Failed"}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"optimalQuantum", "=", 
       RowBox[{"First", "[", 
        RowBox[{"SortBy", "[", 
         RowBox[{"quantumCandidates", ",", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"First", "[", "#", "]"}]}], "&"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"logLQ", ",", 
         RowBox[{"{", 
          RowBox[{"theta1OptQ", ",", "xOptQ"}], "}"}]}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"optimalQuantum", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"theta1", ",", "x"}], "}"}], "/.", " ", 
          RowBox[{"optimalQuantum", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"robustQ", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<successful starts\>\"", "->", 
          RowBox[{"Length", "[", "quantumCandidates", "]"}]}], ",", 
         RowBox[{"\"\<out of\>\"", "->", 
          RowBox[{"Length", "[", "quantumStarts", "]"}]}], ",", 
         RowBox[{"\"\<runner-up gap\>\"", "->", 
          RowBox[{"logLQ", "-", 
           RowBox[{
            RowBox[{"Sort", "[", 
             RowBox[{
              RowBox[{"First", "/@", "quantumCandidates"}], ",", "Greater"}], 
             "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}]}], "  ", "}"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"predictedQ", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"modelQSym", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"theta1", "->", "theta1OptQ"}], ",", 
           RowBox[{"x", "->", "xOptQ"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"G2Q", "=", 
       RowBox[{"2", "*", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"y", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "*", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"y", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"n", "*", 
                RowBox[{"predictedQ", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", "-", 
              RowBox[{"y", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "*", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"n", "*", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"predictedQ", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ")"}]}], 
             "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nItems"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"BICQ", "=", 
       RowBox[{"G2Q", "+", 
        RowBox[{"2", "*", 
         RowBox[{"Log", "[", "nItems", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Dataset\>\"", "->", "sheetName"}], ",", 
        RowBox[{"\"\<TestItems\>\"", "->", "testItems"}], ",", 
        RowBox[{"\"\<Observed\>\"", "->", 
         RowBox[{"y", "/", "n"}]}], ",", 
        RowBox[{"\"\<Classical\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<x\>\"", "->", "xOptC"}], ",", 
           RowBox[{"\"\<delta\>\"", "->", "deltaOpt"}], ",", 
           RowBox[{"\"\<G2\>\"", "->", "G2C"}], ",", 
           RowBox[{"\"\<BIC\>\"", "->", "BICC"}], ",", 
           RowBox[{"\"\<Predicted\>\"", "->", "predictedC"}], ",", 
           RowBox[{"\"\<MultistartGap\>\"", "->", "robustC"}]}], "|>"}]}], ",", 
        RowBox[{"\"\<Quantum\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<x\>\"", "->", "xOptQ"}], ",", 
           RowBox[{"\"\<theta1\>\"", "->", "theta1OptQ"}], ",", 
           RowBox[{"\"\<G2\>\"", "->", "G2Q"}], ",", 
           RowBox[{"\"\<BIC\>\"", "->", "BICQ"}], ",", 
           RowBox[{"\"\<Predicted\>\"", "->", "predictedQ"}], ",", 
           RowBox[{"\"\<RobustnessCheck\>\"", "->", "robustQ"}]}], "|>"}]}]}],
        "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9967555344290123`*^9, 3.9967555344290123`*^9}, {
