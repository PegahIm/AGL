           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "bigram", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", "[", "bigram", "]"}], ",", 
               RowBox[{
                RowBox[{"Last", "[", "bigram", "]"}], "/", 
                RowBox[{"Total", "[", 
                 RowBox[{"Last", "/@", "bigrams"}], "]"}]}]}], "}"}]}], "]"}],
            ",", "bigrams"}], "]"}]}], "]"}], ",", "groupedBigrams"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
