Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PredictionsTable", "[", "res_", "]"}], ":=", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"res", "[", "\"\<TestItems\>\"", "]"}], "[", 
