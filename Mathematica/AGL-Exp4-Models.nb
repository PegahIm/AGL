   RowBox[{
   "Group", " ", "the", " ", "bigrams", " ", "by", " ", "their", " ", "first",
     " ", "letter"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"groupedBigrams", "=", 
     RowBox[{"GroupBy", "[", 
      RowBox[{"bigramCounts", ",", 
       RowBox[{
