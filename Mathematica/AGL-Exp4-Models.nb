         RowBox[{
          RowBox[{"First", "[", "#", "]"}], ",", "1"}], "]"}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "conditional", " ", "bigram", " ", "frequencies"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bigramFrequencies", "=", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"firstLetter", ",", "bigrams"}], "}"}], ",", 
         RowBox[{"Map", "[", 
