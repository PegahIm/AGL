Cell[CellGroupData[{

Cell["Bayesian Probabilities ", "Subsection",
 CellChangeTimes->{{3.940495444487667*^9, 3.9404954493333645`*^9}, {
   3.9404967909570837`*^9, 3.940496803771369*^9}, 3.9570621462883854`*^9, 
   3.9570621765979958`*^9, 3.996748944086172*^9, 3.996750396175009*^9, {
   3.9968284731497364`*^9, 
   3.9968284749567337`*^9}},ExpressionUUID->"cf0e5698-3ba4-d042-9885-\
cae4eda4ba33"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Transition", " ", "probabilities", " ", "from", " ", "training", " ", 
    "frequencies"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"bigramCalculationsClassicalBase", "=", 
     RowBox[{"Association", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "bg", "}"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "bg", "]"}], "==", "2"}], ",", 
            RowBox[{
             RowBox[{"bg", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"N", "[", 
                  RowBox[{"bg", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
                 RowBox[{"1", "-", 
                  RowBox[{"N", "[", 
                   RowBox[{"bg", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "-", 
                  RowBox[{"N", "[", 
                   RowBox[{"bg", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
                 RowBox[{"N", "[", 
                  RowBox[{"bg", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "}"}]}], 
            ",", 
            RowBox[{"bg", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "]"}], ",",
         "flatBigramsList"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"bigramCalculationsClassicalBase", ",", "bg"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"bigramCalculationsClassicalBase", "[", "bg", "]"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"bg", ",", "allBigrams"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bigramCalculationsDelta", "[", "delta_", "]"}], ":=", 
     RowBox[{"Association", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", "=", 
            RowBox[{
             RowBox[{"bigramCalculationsClassicalBase", "[", "bg", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"c2top", "=", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"1", "-", "p", "-", "delta"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}], ",", 
            RowBox[{"bg", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"p", ",", "c2top"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "-", "p"}], ",", 
                 RowBox[{"1", "-", "c2top"}]}], "}"}]}], "}"}]}]}], "]"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"bg", ",", "allBigrams"}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"measurementOperatorClassical", "[", "x_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "-", "x"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "x"}], "}"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"calculateClassicalProbabilityDelta", "[", 
      RowBox[{"string_", ",", "bigramCalcs_", ",", "x_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "bigramsInStr", ",", "firstBigram", ",", "stateVector", ",", "M", ",",
          "L", ",", "U", ",", "result"}], "}"}], ",", 
       RowBox[{
        RowBox[{"bigramsInStr", "=", 
         RowBox[{"StringJoin", "/@", 
          RowBox[{"Partition", "[", 
           RowBox[{
            RowBox[{"Characters", "[", "string", "]"}], ",", "2", ",", "1"}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"firstBigram", "=", 
         RowBox[{"First", "[", "bigramsInStr", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stateVector", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"bigramCalcs", "[", "firstBigram", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"bigramCalcs", "[", "firstBigram", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"U", "=", 
            RowBox[{"bigramCalcs", "[", "bg", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"stateVector", "=", 
            RowBox[{"U", ".", "stateVector"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"bg", ",", 
            RowBox[{"Rest", "[", "bigramsInStr", "]"}]}], "}"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"M", "=", 
         RowBox[{"measurementOperatorClassical", "[", "x", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L", "=", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"result", "=", 
         RowBox[{"L", ".", "M"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Chop", "[", 
         RowBox[{"result", ".", "stateVector"}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.996750358522791*^9, 3.996750358522791*^9}, 
   3.9968284773946075`*^9, {3.9984746909553623`*^9, 
   3.9984747021342125`*^9}},ExpressionUUID->"6e51ee7d-4e76-7142-9ddd-\
ab92a51d37c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FitDataset function ", "Subsection",
