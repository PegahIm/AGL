Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PredictionsTable", "[", "res_", "]"}], ":=", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"res", "[", "\"\<TestItems\>\"", "]"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"res", "[", "\"\<Observed\>\"", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "3"}], "]"}], ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"res", "[", "\"\<Classical\>\"", "]"}], 
               "[", "\"\<Predicted\>\"", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "4"}], "]"}], ",", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"res", "[", "\"\<Quantum\>\"", "]"}], 
               "[", "\"\<Predicted\>\"", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "4"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"res", "[", "\"\<TestItems\>\"", "]"}], "]"}]}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Test item\>\"", ",", "\"\<Observed\>\"", 
         ",", "\"\<Bayesian (predicted)\>\"", 
         ",", "\"\<Quantum (predicted)\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "All"}], ",", 
     RowBox[{"Alignment", "->", "Left"}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"LightGray", ",", "None", ",", "None"}], "}"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
