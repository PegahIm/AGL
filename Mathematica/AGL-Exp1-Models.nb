         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<x = \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"res", "[", "\"\<Classical\>\"", "]"}], 
               "[", "\"\<x\>\"", "]"}], ",", "4"}], "]"}], 
            ",", "\"\<, delta = \>\"", ",", 
