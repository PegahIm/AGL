            "]"}], ",", "6"}], "]"}], ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"res", "[", "\"\<Quantum\>\"", "]"}], "[", "\"\<BIC\>\"", 
            "]"}], ",", "6"}], "]"}], ",", 
