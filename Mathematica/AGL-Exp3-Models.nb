         RowBox[{
          RowBox[{
           RowBox[{"StringJoin", "@@@", 
            RowBox[{"Partition", "[", 
             RowBox[{
              RowBox[{"Characters", "[", "#", "]"}], ",", "2", ",", "1"}], 
             "]"}]}], "&"}], "/@", "strings"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"trigrams", "=", 
         RowBox[{
