              RowBox[{
               RowBox[{"First", "[", "bigram", "]"}], ",", 
               RowBox[{
                RowBox[{"Last", "[", "bigram", "]"}], "/", 
                RowBox[{"Total", "[", 
                 RowBox[{"Last", "/@", "bigrams"}], "]"}]}]}], "}"}]}], "]"}],
            ",", "bigrams"}], "]"}]}], "]"}], ",", "groupedBigrams"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
