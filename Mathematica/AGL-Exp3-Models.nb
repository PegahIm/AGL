              RowBox[{"[", "i", "]"}], "]"}], ",", "4"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"res", "[", "\"\<TestItems\>\"", "]"}], "]"}]}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Test item\>\"", ",", "\"\<Observed\>\"", 
