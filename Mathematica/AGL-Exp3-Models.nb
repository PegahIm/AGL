     RowBox[{"trigramCountsFunc", "[", "trigrams", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"formattedCountsTrigrams", "=", 
     RowBox[{"Rule", "@@@", "trigramCounts"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"chunksFunc", "[", "strings_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bigrams1", ",", "trigrams"}], "}"}], ",", 
       RowBox[{
