       ",", "\"\<bVJTXVJe\>\"", ",", "\"\<bXVXJe\>\"", ",", "\"\<bXXXXVXe\>\"",
        ",", "\"\<bXVTe\>\"", ",", "\"\<bVJTVJe\>\"", 
       ",", "\"\<bVXJJJJe\>\""}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"strings2", "=", 
